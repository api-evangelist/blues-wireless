{
  "opencollection": "1.0.0",
  "info": {
    "name": "Notehub alert authorization API",
    "version": "1.2.0"
  },
  "items": [
    {
      "info": {
        "name": "authorization",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Login",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.notefile.net/auth/login",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Gets an API key from username and password"
        },
        {
          "info": {
            "name": "Issue an OAuth 2.0 access token (Client Credentials)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.notefile.net/oauth2/token",
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "client_id",
                  "value": ""
                },
                {
                  "name": "client_secret",
                  "value": ""
                },
                {
                  "name": "grant_type",
                  "value": ""
                },
                {
                  "name": "scope",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Exchanges client credentials for an access token. Parameters must be sent as application/x-www-form-urlencoded.\n"
        }
      ]
    }
  ],
  "bundled": true
}