                "type": "path"
              },
              {
                "name": "reportUID",
                "value": "my-reconciliation-job-1707654321000",
                "type": "path",
                "description": "Unique identifier for a job run report"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
