          "info": {
            "name": "GetJobs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.notefile.net/v1/projects/:projectOrProductUID/jobs",
            "params": [
              {
                "name": "projectOrProductUID",
                "value": "app:2606f411-dea6-44a0-9743-1130f57d77d8",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List all batch jobs for a project"
        },
        {
          "info": {
            "name": "CreateJob",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.notefile.net/v1/projects/:projectOrProductUID/jobs",
            "params": [
              {
                "name": "projectOrProductUID",
                "value": "app:2606f411-dea6-44a0-9743-1130f57d77d8",
                "type": "path"
